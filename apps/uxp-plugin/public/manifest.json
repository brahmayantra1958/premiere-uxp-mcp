{
  "manifestVersion": 5,
  "id": "ai.brahma.yantra.pr-uxp-mcp",
  "name": "Premiere UXP MCP",
  "shortname": "Premiere MCP",
  "version": "0.16.10",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "requiredPermissions": {
    "launchProcess": {
      "extensions": [
        ".exe",
        ".app"
      ],
      "schemes": []
    },
    "localFileSystem": "request",
    "ipc": {
      "enablePluginCommunication": true
    },
    "network": {
      "domains": [
        "ws://127.0.0.1/",
        "ws://localhost/",
        "http://127.0.0.1/",
        "http://127.0.0.1:8098/",
        "http://localhost:8098/",
        "http://127.0.0.1:8095/",
        "http://localhost:8095/",
        "http://localhost/"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "premiereUxpMcpPanel",
      "type": "panel",
      "label": {
        "default": "Premiere UXP MCP"
      },
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 700
      }
    }
  ]
}
